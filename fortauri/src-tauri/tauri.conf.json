{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CreatorEngine",
  "version": "0.2.0",
  "identifier": "com.creatorengine.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "创作引擎 · 游戏构思向导",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
